# Copy to .env and fill in as needed. All values are optional.

# --- LLM (all optional) ---
# Backend selection: auto | claude | hf | ollama | groq | heuristic
#   auto (default): prefer Claude, then Hugging Face, then Groq, then heuristic.
SENTINEL_LLM_PROVIDER=auto

# Cost/model routing (spec Section 8) — optional. Route the cheap "parse raw
# scanner output into JSON" step and the "reason/confirm + report" step to
# different providers. Empty = use SENTINEL_LLM_PROVIDER for both.
# Example: cheap Groq for parsing, Claude for reasoning + report prose.
SENTINEL_PARSE_PROVIDER=
SENTINEL_REASON_PROVIDER=  

# Anthropic Claude
ANTHROPIC_API_KEY=
SENTINEL_CLAUDE_MODEL=claude-opus-5

# Ollama (local, free — set SENTINEL_LLM_PROVIDER=ollama to use it)
# Install from https://ollama.com/download, then: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq (fast, cheap open models — get a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face (OpenAI-compatible router / Inference Providers)
# Get a token at https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# --- OWASP ZAP daemon (optional; ignored in --mock mode) ---
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# --- Nmap (optional) ---
NMAP_BINARY=nmap

# --- Behavior ---
# Use bundled sample scan data instead of live tools.
SENTINEL_MOCK=0
# Allow scanning non-local targets you own (off by default; see LEGAL/ETHICS).
SENTINEL_ALLOW_ANY=0
# Extra approved hosts, comma-separated.
SENTINEL_APPROVED_HOSTS=
# Where reports are written.
SENTINEL_REPORTS_DIR=reports

